# Copy to .streamlit/secrets.toml (kept out of version control) when
# deploying on Streamlit Community Cloud or Streamlit-in-Snowflake.
# Locally, a .env file (see .env.example) is enough — config.py checks
# Streamlit secrets first, then falls back to environment variables.

DHAN_CLIENT_ID = "your_dhan_client_id"
DHAN_ACCESS_TOKEN = "your_dhan_access_token"

# Optional
SUPABASE_URL = ""
SUPABASE_KEY = ""
