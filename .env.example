# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- Dhan API (required) ---
# From the Dhan web app: My Profile > DhanHQ Trading APIs
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# --- Supabase (optional — for historical snapshot storage) ---
# Leave blank to use local SQLite only (default, no setup required).
SUPABASE_URL=
SUPABASE_KEY=

# --- NIFTY futures Security ID override (optional, V2.1) ---
# By default the app resolves the current-month NIFTY futures contract
# dynamically from Dhan's public instrument master CSV. Set this only if
# that resolution fails in your environment (e.g. the instrument master
# URL/schema changed, or your network can't reach it) — leave blank
# otherwise, since a manual ID silently goes stale after expiry rollover.
DHAN_NIFTY_FUT_SECURITY_ID=
